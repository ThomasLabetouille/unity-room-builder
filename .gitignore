.vscode/

# Sorties de build des outils .NET (Tools/)
[Bb]in/
[Oo]bj/

# Copies de sauvegarde faites a la main pendant le developpement
/_backup_editor/

# Crashs et OS
sysinfo.txt
*.stackdump
.DS_Store
Thumbs.db

# Maillages produits en essayant l'outil : regeneres a chaque usage, aucun
# interet a les versionner.
/Assets/GeneratedMeshes/
/Assets/GeneratedMeshes.meta
